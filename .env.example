# Copy to .env.local and fill in your own values. Never commit .env.local.
# Server-side only: never prefix these with NEXT_PUBLIC_.

# AI providers
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
ADAPTION_API_KEY=

# Optional, only if the product needs them
DATABASE_URL=
AUTH_SECRET=

# Public client-safe values only
NEXT_PUBLIC_APP_URL=http://localhost:3000
